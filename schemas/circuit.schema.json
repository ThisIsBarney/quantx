{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantumCircuit",
  "type": "object",
  "properties": {
    "qubits": { "type": "integer", "minimum": 1 },
    "shots": { "type": "integer", "minimum": 0 },
    "observables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depolarizing_prob": { "type": "number", "minimum": 0, "maximum": 1 },
    "amplitude_damping_gamma": { "type": "number", "minimum": 0, "maximum": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "targets": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "controls": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "params": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["qubits", "operations"],
  "additionalProperties": true
}
