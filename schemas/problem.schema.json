{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantumProblem",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "discrete",
        "continuous_space_2d",
        "continuous2d",
        "continuous_2d",
        "continuous_space_3d",
        "continuous3d",
        "continuous_3d"
      ]
    },
    "qubits": { "type": "integer", "minimum": 1 },
    "equation": {
      "type": "string",
      "enum": ["Schrodinger", "Lindblad", "Dirac", "KleinGordon"]
    },
    "total_time": { "type": "number", "minimum": 0 },
    "dt": { "type": "number", "exclusiveMinimum": 0 },
    "method": { "type": "string" },
    "krylov_dim": { "type": "integer", "minimum": 1 },
    "mps_max_bond": { "type": "integer", "minimum": 2 },
    "mps_trunc_tol": { "type": "number", "exclusiveMinimum": 0 },
    "target_error": { "type": "number", "exclusiveMinimum": 0 },
    "expected_circuit_depth": { "type": "integer", "minimum": 0 },
    "noisy": { "type": "boolean" },
    "continuous_space_2d": {
      "type": "object",
      "properties": {
        "nx": { "type": "integer", "minimum": 1 },
        "ny": { "type": "integer", "minimum": 1 },
        "dx": { "type": "number", "exclusiveMinimum": 0 },
        "dy": { "type": "number", "exclusiveMinimum": 0 },
        "dt": { "type": "number", "exclusiveMinimum": 0 },
        "steps": { "type": "integer", "minimum": 1 },
        "boundary": { "type": "string" },
        "potential_kind": { "type": "string" },
        "potential_params": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "potential_grid": {
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "additionalProperties": true
    },
    "continuous_space_3d": {
      "type": "object",
      "properties": {
        "nx": { "type": "integer", "minimum": 1 },
        "ny": { "type": "integer", "minimum": 1 },
        "nz": { "type": "integer", "minimum": 1 },
        "dx": { "type": "number", "exclusiveMinimum": 0 },
        "dy": { "type": "number", "exclusiveMinimum": 0 },
        "dz": { "type": "number", "exclusiveMinimum": 0 },
        "dt": { "type": "number", "exclusiveMinimum": 0 },
        "steps": { "type": "integer", "minimum": 1 },
        "boundary": { "type": "string" },
        "potential_kind": { "type": "string" },
        "potential_params": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "potential_grid": {
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "additionalProperties": true
    },
    "hamiltonian_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "coefficient": { "type": "number" }
        },
        "required": ["label", "coefficient"],
        "additionalProperties": false
      }
    }
  },
  "required": ["qubits"],
  "additionalProperties": true
}
