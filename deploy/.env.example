# QuantX deployment environment variables
# Copy to .env at repo root and fill in secrets before running docker compose.
#
#   cp deploy/.env.example .env
#   docker compose -f deploy/docker-compose.yml up -d

# ── API server ─────────────────────────────────────────────────────────────────

# TCP port the API server listens on (default 8000)
QUANTX_PORT=8000

# Docker image tag to deploy (default: latest built from Dockerfile)
QUANTX_IMAGE_TAG=latest

# ── Authentication (leave blank for open-access development mode) ─────────────

# Comma-separated list of valid API keys (e.g. sk-prod-abc123,sk-ci-def456)
QUANTX_API_KEYS=

# HS256 JWT signing secret — REQUIRED when QUANTX_API_KEYS is set.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
QUANTX_JWT_SECRET=

# Maximum requests per minute per API key (default 60)
QUANTX_RATE_LIMIT_RPM=60

# ── Job store ──────────────────────────────────────────────────────────────────

# Backend URL — leave as redis://redis:6379/0 for the Compose stack.
# Use sqlite:///path/to/jobs.db for single-node file persistence.
QUANTX_JOB_STORE_URL=redis://redis:6379/0

# ── Observability ─────────────────────────────────────────────────────────────

# OpenTelemetry OTLP collector endpoint (leave blank to disable tracing)
# Example: http://jaeger:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Grafana ────────────────────────────────────────────────────────────────────

# Grafana admin password (change before exposing publicly)
GRAFANA_ADMIN_PASSWORD=admin

# TCP port for the Grafana web UI (default 3000)
GRAFANA_PORT=3000
